root = true

[*]
charset = utf-8
# LF, not CRLF: .gitattributes normalises the repository to LF, and disagreeing
# with it here would make every save show up as a whole-file diff.
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space

[*.cs]
indent_size = 4

[*.{js,ts,jsx,tsx,mjs,mts,json,yml,yaml}]
indent_size = 2

[*.{csproj,slnx,props,targets}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false
